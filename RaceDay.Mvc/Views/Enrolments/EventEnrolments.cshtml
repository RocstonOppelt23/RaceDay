@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Entrants";
    int active = Model.Enrolments.Count(e => e.IsActive);
}
<a asp-action="Index" class="small d-inline-block mt-3">&larr; All events</a>
<div class="d-flex flex-wrap justify-content-between align-items-end">
    <div>
        <h1 class="page-title mt-1">Entrants: @Model.Event.Name</h1>
        <p class="page-subtitle">@Model.Event.EventDate.ToString("dddd d MMMM yyyy") &middot; @active active of @Model.Enrolments.Count enrolments</p>
    </div>
    <a class="btn btn-outline-primary mb-4" asp-controller="Results" asp-action="EventResults" asp-route-eventId="@Model.Event.EventId">View results</a>
</div>

@if (!Model.Enrolments.Any())
{
    <div class="empty-state">Nobody has entered this event yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-rd mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Entered on</th>
                    <th>Status</th>
                    <th>Result</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    Model.Results.TryGetValue(e.EnrolmentId, out var result);
                    <tr class="@(e.IsActive ? "" : "row-cancelled")">
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td><span class="badge @(e.IsActive ? "badge-confirmed" : "badge-cancelled")">@e.Status</span></td>
                        <td>
                            @if (result != null)
                            {
                                <span class="position-medal @(result.FinishingPosition <= 3 ? $"p{result.FinishingPosition}" : "")">@result.FinishingPosition</span>
                                <span class="ms-1">@result.FinishTime.ToString(@"hh\:mm\:ss")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (result == null && e.IsActive)
                            {
                                <a class="btn btn-sm btn-gold" asp-controller="Results" asp-action="Capture"
                                   asp-route-enrolmentId="@e.EnrolmentId" asp-route-eventId="@Model.Event.EventId">Capture result</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
