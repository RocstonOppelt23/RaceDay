@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Create Event" : "Edit Event";
    string action = Model.IsNew ? "Create" : "Edit";
}
<h1 class="page-title">@(Model.IsNew ? "Create an event" : $"Edit {Model.Name}")</h1>
<p class="page-subtitle">@(Model.IsNew ? "Add the details, then add categories once it's saved." : "Update the details or upload a new banner.")</p>

<div class="rd-card form-card" style="max-width: 760px;">
    <div class="card-body">
        <form asp-action="@action" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="ExistingBannerUrl" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Cape Town Sunrise 10km" />
                <span asp-validation-for="Name" class="small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Route, start point, what to bring..."></textarea>
                <span asp-validation-for="Description" class="small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control"
                           value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="EventDate" class="small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Sea Point Promenade" />
                    <span asp-validation-for="Location" class="small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Distance" class="form-label"></label>
                    <input asp-for="Distance" type="number" step="0.01" min="0.1" class="form-control"
                           value="@(Model.Distance == 0 ? "" : Model.Distance.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    <span asp-validation-for="Distance" class="small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label for="banner" class="form-label">Banner image <span class="text-muted fw-normal">(optional, JPG/PNG/WEBP/GIF, up to 5 MB)</span></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ExistingBannerUrl" class="banner-preview" alt="Current banner" />
                        <div class="small text-muted">Current banner. Choose a new file to replace it.</div>
                    </div>
                }
                <input id="banner" name="banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                <span class="field-validation-error small">@Html.ValidationMessage("banner")</span>
            </div>

            <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Create event" : "Save changes")</button>
            <a asp-action="ManageIndex" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
