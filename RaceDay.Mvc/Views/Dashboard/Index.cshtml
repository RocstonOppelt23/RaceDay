@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-end">
    <div>
        <h1 class="page-title">Welcome back, @Model.OrganiserName.Split(' ')[0]</h1>
        <p class="page-subtitle">Here's how your events are looking.</p>
    </div>
    <a class="btn btn-gold mb-4" asp-controller="Events" asp-action="Create">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-value">@Model.TotalEvents</div>
            <div class="stat-label">Total events</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-tile gold">
            <div class="stat-value">@Model.UpcomingCount</div>
            <div class="stat-label">Upcoming</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-tile green">
            <div class="stat-value">@Model.TotalEnrolments</div>
            <div class="stat-label">Active enrolments</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-tile">
            <div class="stat-value">@Model.PastCount</div>
            <div class="stat-label">Past events</div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Upcoming events</h2>
@if (!Model.UpcomingEvents.Any())
{
    <div class="empty-state">
        You have no upcoming events. <a asp-controller="Events" asp-action="Create">Create your first one</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-rd mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Event</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th class="text-center">Entrants</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.UpcomingEvents)
                {
                    var days = (ev.EventDate.Date - DateTime.Today).Days;
                    <tr>
                        <td>
                            <div class="fw-semibold">@ev.EventDate.ToString("d MMM yyyy")</div>
                            <div class="small text-muted">@(days == 0 ? "Today" : days == 1 ? "Tomorrow" : $"In {days} days")</div>
                        </td>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId">@ev.Name</a></td>
                        <td><span class="badge badge-type @ev.EventType">@ev.EventType</span></td>
                        <td>@ev.Location</td>
                        <td class="text-center fw-bold">@(Model.EnrolmentCounts.TryGetValue(ev.EventId, out var n) ? n : 0)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Enrolments" asp-action="EventEnrolments" asp-route-eventId="@ev.EventId">Entrants</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Categories" asp-action="Manage" asp-route-eventId="@ev.EventId">Categories</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
