@model List<ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}
<h1 class="page-title">My results</h1>
<p class="page-subtitle">Your race history, most recent first.</p>

@if (!Model.Any())
{
    <div class="empty-state">No results yet. They'll appear here once an organiser publishes them after your event.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-tile"><div class="stat-value">@Model.Count</div><div class="stat-label">Races finished</div></div>
        </div>
        <div class="col-sm-4">
            <div class="stat-tile gold"><div class="stat-value">@Model.Min(r => r.FinishingPosition)</div><div class="stat-label">Best position</div></div>
        </div>
        <div class="col-sm-4">
            <div class="stat-tile green"><div class="stat-value">@Model.Count(r => r.FinishingPosition <= 3)</div><div class="stat-label">Podium finishes</div></div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-rd mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold">@r.EventName</td>
                        <td>@r.EventDate?.ToString("d MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                        <td><span class="position-medal @(r.FinishingPosition <= 3 ? $"p{r.FinishingPosition}" : "")">@r.FinishingPosition</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
