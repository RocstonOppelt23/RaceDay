@model BrowseEventsViewModel
@{
    ViewData["Title"] = "Home";
    string[] types = { "Run", "Walk", "Cycle" };
    var role = Context.Session.GetString(SessionKeys.Role);
}
<section class="hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1>Find your next <span class="accent">race day</span>.</h1>
            <p class="lead mb-4">Road runs, walks and cycle events across South Africa. Enter in a couple of clicks and track your results in one place.</p>
            @if (role == null)
            {
                <a class="btn btn-gold btn-lg me-2" asp-controller="Account" asp-action="Register">Create an account</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            }
            else if (role == Roles.Organiser)
            {
                <a class="btn btn-gold btn-lg" asp-controller="Dashboard" asp-action="Index">Go to your dashboard</a>
            }
            else
            {
                <a class="btn btn-gold btn-lg" asp-controller="Events" asp-action="Browse">Browse all events</a>
            }
        </div>
    </div>
</section>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h2 class="h4 mb-0">Upcoming events</h2>
        <div class="text-muted small">The next events on the calendar</div>
    </div>
</div>

<form method="get" asp-controller="Home" asp-action="Index" class="rd-card mb-4">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-4">
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or place" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in types)
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="fromDate" class="form-label">On or after</label>
            <input id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="empty-state">No upcoming events match those filters. Try clearing them.</div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
    @if (role == null)
    {
        <p class="text-muted small mt-3">Log in or register to see full details and enter.</p>
    }
}
