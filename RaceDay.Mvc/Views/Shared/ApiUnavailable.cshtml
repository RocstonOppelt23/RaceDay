@{
    ViewData["Title"] = "Service unavailable";
}
<div class="empty-state mt-5">
    <h1 class="h3">RaceDay is having trouble right now</h1>
    <p>We couldn't reach the RaceDay service. Please try again in a moment.</p>
    <p class="small">Running locally? Check that the RaceDay API is running and that <code>ApiBaseUrl</code> in appsettings.json matches its address.</p>
    <a class="btn btn-primary" href="javascript:location.reload()">Try again</a>
</div>
