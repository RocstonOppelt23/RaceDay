@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    string initials = string.Concat(new[] { Model.FirstName, Model.LastName }
        .Where(n => !string.IsNullOrEmpty(n)).Select(n => char.ToUpperInvariant(n[0])));
}
<h1 class="page-title">My profile</h1>
<p class="page-subtitle">The details organisers see when you enter their events.</p>

<div class="rd-card" style="max-width: 720px;">
    <div class="card-body d-flex flex-column flex-sm-row gap-4 align-items-sm-center">
        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
        {
            <img src="@Model.ProfilePictureUrl" class="avatar" alt="Profile picture of @Model.FullName" />
        }
        else
        {
            <div class="avatar-placeholder" aria-hidden="true">@initials</div>
        }
        <div class="flex-grow-1">
            <h2 class="h4 mb-1">@Model.FullName</h2>
            <span class="badge badge-type">@Model.Role</span>
            <dl class="row mt-3 mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not added" : Model.PhoneNumber)</dd>
                <dt class="col-sm-4">Date of birth</dt>
                <dd class="col-sm-8">@(Model.DateOfBirth?.ToString("d MMMM yyyy") ?? "Not added")</dd>
            </dl>
        </div>
    </div>
    <div class="card-body border-top">
        <a class="btn btn-primary" asp-action="Edit">Edit profile</a>
    </div>
</div>
