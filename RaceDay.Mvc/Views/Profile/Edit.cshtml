@model ProfileFormViewModel
@{
    ViewData["Title"] = "Edit Profile";
}
<h1 class="page-title">Edit profile</h1>
<p class="page-subtitle">Update your details or upload a new picture.</p>

<div class="rd-card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="ProfilePictureUrl" />

            <div class="d-flex align-items-center gap-3 mb-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="avatar" style="width:80px;height:80px" alt="Current profile picture" />
                }
                <div class="flex-grow-1">
                    <label for="profilePicture" class="form-label">Profile picture <span class="text-muted fw-normal">(JPG/PNG/WEBP/GIF, up to 5 MB)</span></label>
                    <input id="profilePicture" name="profilePicture" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" />
                    <span class="field-validation-error small">@Html.ValidationMessage("profilePicture")</span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="small"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="small"></span>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="082 555 1234" />
                    <span asp-validation-for="PhoneNumber" class="small"></span>
                </div>
                <div class="col-sm-6 mb-4">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control"
                           value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth" class="small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
